      "sessionId": 16909060
    },
    {
      "id": "uwb-controlee",
      "kind": "controlee",
      "hex": "5101021234",
      "address": "1234"
    },
    {
      "id": "uwb-opaque-apple",
      "kind": "opaque",
      "hex": "510103deadbeef",
      "blob": "deadbeef"
    }
  ],
  "rejected": [
    {
      "id": "uwb-wrong-magic",
      "why": "A token whose magic byte is not 'Q' \u2014 anything else on that characteristic is not this profile.",
