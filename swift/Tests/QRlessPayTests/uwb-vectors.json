    },
    {
      "id": "uwb-future-version",
      "why": "Version 2. A future revision must fail closed here rather than be read with v1 field offsets.",
      "hex": "510201abcd090a01020304"
    },
    {
      "id": "uwb-unknown-kind",
      "why": "Kind 9 is not controller, controlee or opaque.",
      "hex": "510109abcd"
    },
    {
      "id": "uwb-controller-short-payload",
      "why": "Controller payload one byte short \u2014 decoding it would read a session id from adjacent bytes.",
      "hex": "510101abcd090a010203"
    },
    {
      "id": "uwb-controlee-wrong-length",
      "why": "Controlee address must be exactly two bytes.",
      "hex": "510102ab"
    },
    {
      "id": "uwb-opaque-empty",
      "why": "An empty Apple token carries nothing to hand back to the platform.",
      "hex": "510103"
    },
    {
      "id": "uwb-header-only",
      "why": "Three bytes and no payload.",
      "hex": "5101"
