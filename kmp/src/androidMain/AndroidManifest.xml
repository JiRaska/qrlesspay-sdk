<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The payer role needs SCAN+CONNECT; the payee role needs ADVERTISE. neverForLocation is
         load-bearing: without it Android treats a BLE scan as a location request, and asking a
         payer for location permission to accept a payment is a permission dialog nobody grants. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
</manifest>
